<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjjw.dynamics.example.mapper.UserMapper">

    <sql id="userColumns">id, name, dept</sql>

    <select id="selectById" resultType="com.bjjw.dynamics.example.entity.User">
        SELECT <include refid="userColumns"/> FROM t_user WHERE id = #{id}
    </select>
</mapper>